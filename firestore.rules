rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /simulations/{simId} {
        allow read, write: if false; // all access via the REST API - Admin SDK bypasses this
      }
    }

    match /cpi/{period} {
      allow read, write: if false; // served via GET /v1/cpi
    }

    match /priceHistory/{docId} {
      allow read, write: if false; // served via GET /v1/assets/:symbol/history
    }

    match /{document=**} {
      allow read, write: if false; // deny everything else by default
    }
  }
}
